# Telegram local/VPS only. Leave unset on Vercel.
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_AUTH_PASSWORD=change_me
TELEGRAM_AUTH_PATH=./data/telegram-auth.json
TELEGRAM_OUTBOX_PATH=./data/telegram-outbox.json
TELEGRAM_OUTBOX_INTERVAL_MS=10000
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token
# Default: if BLOB_READ_WRITE_TOKEN exists, bot/VPS/dashboard share JSON state through Blob.
# Set STATE_STORE=local if you explicitly want local JSON files only.
STATE_STORE=blob

# Dashboard admin login
ADMIN_USER=admin
ADMIN_PASSWORD=change_me
ADMIN_SESSION_SECRET=replace_with_a_long_random_string

# Server
PORT=3000
APP_TIME_ZONE=Europe/Paris
START_DAILY_SCHEDULER=false

# Output
OUTPUT_DIR=./output

# Puppeteer optional custom Chrome path on VPS
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# SQLite
DB_PATH=./data/carousel-gen.sqlite

# Daily automation from a .template file
ENABLE_DAILY_GENERATION=false
DAILY_GENERATION_TIME=09:00
DAILY_TEMPLATE_PATH=./templates/daily.template
DAILY_ACCOUNT_SLUG=account-1
DAILY_TOPIC=
DAILY_USE_GEMINI=false
DAILY_SEND_TELEGRAM=true
DAILY_TELEGRAM_CHAT_ID=
DAILY_JOBS_PATH=./data/daily-jobs.json
POST_TRACKING_PATH=./data/post-tracking.json
ACCOUNTS_STATE_PATH=./data/accounts.json
TEMPLATES_STATE_PATH=./data/templates.json

# Gemini CLI text generation. Install with:
# npm install -g @google/gemini-cli
# Then run `gemini` locally and choose "Login with Google" before enabling.
ENABLE_GEMINI_CLI=false
GEMINI_MODE=auto
GEMINI_CLI_COMMAND=gemini
GEMINI_CLI_ARGS=-p
GEMINI_CLI_TIMEOUT_MS=120000

# MCP
MCP_FORCE_ASYNC_GENERATION=false
PUPPETEER_NAVIGATION_TIMEOUT_MS=60000
